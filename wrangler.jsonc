{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "somsbeauty-preview",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "somsbeauty.com/*", "zone_name": "somsbeauty.com" },
    { "pattern": "www.somsbeauty.com/*", "zone_name": "somsbeauty.com" }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  }
}
